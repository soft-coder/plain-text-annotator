/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@pta/data-access": ["projects/shared-data-access/src/public-api.ts"],
      "@pta/ui": ["projects/shared-ui/src/public-api.ts"],
      "@pta/model": ["projects/shared-model/src/public-api.ts"],
      "@pta/util": ["projects/shared-util/src/public-api.ts"],
      "@pta/feature-article": ["projects/feature-article/src/public-api.ts"]
    },
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/shell/tsconfig.app.json"
    },
    {
      "path": "./projects/shell/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-data-access/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-ui/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-model/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-model/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared-util/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-util/tsconfig.spec.json"
    },
    {
      "path": "./projects/feature-article/tsconfig.lib.json"
    },
    {
      "path": "./projects/feature-article/tsconfig.spec.json"
    }
  ]
}
